    "/api/verify": {
      "post": {
        "summary": "Paid verification of a digest or PNG/JPEG",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "imageHash": {
                    "$ref": "#/components/schemas/Hash"
                  },
                  "assetBase64": {
                    "type": "string",
                    "description": "Canonical base64 PNG/JPEG, max decoded size 3 MB"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "imageHash"
                    ]
                  },
                  {
                    "required": [
                      "assetBase64"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verification"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected or service unavailable; inspect error.code",
