  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Alternative to the Bearer header. If both are sent they must match."
      }
    },
    "schemas": {
      "Hash": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$",
        "description": "SHA-256 of the final file bytes, no 0x prefix"
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "used": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "remaining": {
            "type": "integer"
          },
          "resetsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Network": {
        "type": "object",
        "properties": {
          "chainId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "explorer": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          },
          "testnet": {
            "type": "boolean"
          }
        }
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "imageHash",
          "issuerId",
          "source",
          "model",
          "issuedAt",
          "nonce"
        ],
        "properties": {
          "imageHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "issuerId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._:/-]{1,120}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._:/-]{1,120}$"
          },
          "model": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._:/-]{1,120}$"
          },
          "nonce": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._:/-]{1,120}$"
          },
          "issuedAt": {
            "type": "integer",
            "description": "Unix seconds; new registrations require a claim within the last 24 hours"
          }
        }
      },
      "Envelope": {
        "type": "object",
        "required": [
          "version",
          "kind",
          "domain",
          "claim",
          "signature"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "issuer_attestation"
            ]
          },
          "domain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "chainId",
              "verifyingContract"
            ],
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "ZorAI Provenance"
                ]
              },
              "version": {
                "type": "string",
                "enum": [
                  "1"
                ]
              },
              "chainId": {
                "type": "integer"
              },
              "verifyingContract": {
                "type": "string"
              }
            }
          },
          "claim": {
            "$ref": "#/components/schemas/Claim"
          },
          "signature": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{130}$"
          }
        }
      },
      "Verification": {
        "type": "object",
        "required": [
          "imageHash",
          "status",
          "isAiGenerated",
          "network",
          "found"
        ],
        "properties": {
          "imageHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "found": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "attested",
              "unknown",
              "unvalidated_record",
              "untrusted_attestation",
              "mismatch"
            ]
          },
          "isAiGenerated": {
            "type": "boolean",
            "nullable": true,
            "description": "True only for an approved matching attestation; null is inconclusive. Never false."
          },
          "aiOrigin": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "issuer": {
            "type": "object"
          },
          "source": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "evidenceCid": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "signatureValid": {
                "type": "boolean"
              },
              "assetBinding": {
                "type": "string"
              },
              "envelope": {
                "$ref": "#/components/schemas/Envelope"
              }
            }
          },
          "inspection": {
            "type": "object",
            "description": "Untrusted metadata observations for file requests only"
          },
          "limitations": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "imageHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "confirmed",
              "failed",
              "dropped"
            ]
          },
          "txHash": {
            "type": "string",
            "nullable": true
          },
          "evidenceCid": {
            "type": "string",
            "nullable": true
          },
          "blockNumber": {
            "type": "integer",
            "nullable": true
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expiresAt": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        }
      }
    }
  }
}
