  "openapi": "3.0.3",
  "info": {
    "title": "ZorAI Provenance API",
    "version": "1.0.0-pilot",
    "description": "Approved issuer attestations with exact-file matching. Unknown is inconclusive. Direct provider integrations, C2PA validation and checkout are not live."
  },
