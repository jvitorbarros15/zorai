# Copy to .env.local. Never commit secret values.
# Local examples use no funded signer or automatically enabled client.
ZORAI_CHAIN_ID=84532
NEXT_PUBLIC_CONTRACT_ADDRESS=
ZORAI_RPC_URL=https://sepolia.base.org
ZORAI_SIGNER_PRIVATE_KEY=
PRIVATE_KEY=
PINATA_JWT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JSON arrays. Store SHA-256 hashes of random API keys, never raw keys.
# Client: {"id":"pilot","keyHash":"<sha256>","active":false,"scopes":["verify"],"monthlyLimit":1000}
# Issuer clients additionally need issuerId, register scope and dailyRegistrationLimit.
ZORAI_CLIENTS_JSON=[]
# Issuer: {"id":"studio","name":"Approved studio","address":"0x...","active":true,"sources":["approved-source"]}
ZORAI_ISSUERS_JSON=[]
