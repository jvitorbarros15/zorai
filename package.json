    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "chai": "4.5.0",
    "autoprefixer": "^10.4.17",
    "dotenv": "^17.4.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.25",
    "hardhat": "^2.28.6",
    "jest": "^30.4.2",
    "node-mocks-http": "^1.17.2",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1"
  },
